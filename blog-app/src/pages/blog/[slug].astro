---
import Layout from '../../layouts/Layout.astro';
import PostBody from '../../components/PostBody.tsx';
import { reader, getPosts, formatDate } from '../../lib/posts';
import { AUTHOR, SITE } from '../../lib/site';
import { icons, linkIcon } from '../../lib/icons';
import { withHeadingIds } from '../../lib/doc';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((p) => ({ params: { slug: p.slug } }));
}
const { slug } = Astro.params;
const entry = await reader.collections.posts.read(slug!);
if (!entry) return Astro.redirect('/blog/');
const raw = await entry.body();
const { doc: body, toc } = withHeadingIds(raw as any);
const posts = await getPosts();
const arrow = '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m0 0-7-7m7 7-7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const more = posts.filter((p) => p.slug !== slug).slice(0, 6);
const path = `/blog/${slug}/`;
const published = entry.date ?? '';
const metaTitle = entry.metaTitle || entry.title;
const metaDescription = entry.metaDescription || entry.summary;
const cover = entry.cover ? '/blog-img/' + entry.cover : null;
---
<Layout
  title={`${metaTitle} — Disha Shah`}
  description={metaDescription}
  path={path}
  image={cover ?? undefined}
  type="article"
  published={published}
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: entry.title, description: metaDescription, ...(entry.aiSummary ? { abstract: entry.aiSummary } : {}), keywords: entry.tags.join(', '), datePublished: published, author: { '@type': 'Person', name: AUTHOR.name, jobTitle: AUTHOR.role, url: AUTHOR.url }, mainEntityOfPage: 'https://disha-shah.io' + path, image: cover ? 'https://disha-shah.io' + cover : undefined },
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://disha-shah.io/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://disha-shah.io/blog/' },
      { '@type': 'ListItem', position: 3, name: entry.title, item: 'https://disha-shah.io' + path },
    ] },
  ]}
>
  <article>
    <header class="wd-head">
      <p class="wd-eyebrow post-meta" data-intro><span>Published: <b>{formatDate(published)}</b></span></p>
      <div class="post-author" data-intro>
        <img src={AUTHOR.photo} alt="" width="44" height="44" />
        <p><b>{AUTHOR.name}</b><span>{AUTHOR.role}</span></p>
      </div>
      <h1 class="wd-title h-primary" data-intro>{entry.title}</h1>
      <p class="wd-sub" data-intro>{entry.summary}</p>
      {entry.tags.length > 0 && (
        <div class="wd-cap" data-intro><span class="wd-cap__label">Topics</span><div class="wd-cap__chips">{entry.tags.map((t) => <span class="chip">{t}</span>)}</div></div>
      )}
    </header>
    <div class="post-tools wd-text" data-reveal>
      <div class="post-ai" role="group" aria-label="Summarize with AI">
        <span class="post-label">Summarize with AI</span>
        <div>
          {[['ChatGPT', 'https://chatgpt.com/?q='], ['Claude', 'https://claude.ai/new?q='], ['Perplexity', 'https://www.perplexity.ai/search?q='], ['Google AI', 'https://www.google.com/search?udm=50&q=']].map(([n, u]) => (
            <a href={u + encodeURIComponent(`Summarize this article by ${AUTHOR.name} and list the key takeaways: ${SITE}${path}`)} target="_blank" rel="noopener noreferrer"><Fragment set:html={icons[n]} /><span>{n}</span></a>
          ))}
        </div>
      </div>
      <div class="post-share" role="group" aria-label="Share this article">
        <span class="post-label">Share</span>
        <div>
          <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(SITE + path)}&text=${encodeURIComponent(entry.title)}`} target="_blank" rel="noopener noreferrer"><Fragment set:html={icons.X} /><span>X</span></a>
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(SITE + path)}`} target="_blank" rel="noopener noreferrer"><Fragment set:html={icons.LinkedIn} /><span>LinkedIn</span></a>
          <a href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer" data-copy-link={SITE + path} data-copied="Link copied, paste it in Instagram"><Fragment set:html={icons.Instagram} /><span>Instagram</span></a>
          <button type="button" data-copy-link={SITE + path}><Fragment set:html={linkIcon} /><span>Copy link</span></button>
        </div>
      </div>
      {toc.length > 1 && (
        <nav class="post-toc" aria-label="In this article">
          <span class="post-label">In this article</span>
          <ol>{toc.map((t) => <li class={t.level === 3 ? 'is-sub' : ''}><a href={`#${t.id}`}>{t.text}</a></li>)}</ol>
        </nav>
      )}
    </div>
    {cover && (
      <div class="wd-media" data-reveal><img src={cover} alt={entry.coverAlt || entry.title} width="1356" height="763" fetchpriority="high" /></div>
    )}
    <PostBody document={body as any} />
  </article>
  <script is:inline>
    document.querySelectorAll('[data-copy-link]').forEach(function (b) {
      b.addEventListener('click', function () {
        var t = b.getAttribute('data-copy-link'), l = b.querySelector('span'), m = b.getAttribute('data-copied') || 'Copied';
        var d = function () { var o = l.textContent; l.textContent = m; setTimeout(function () { l.textContent = o; }, 2200); };
        if (navigator.clipboard) navigator.clipboard.writeText(t).then(d, d); else d();
      });
    });
  </script>
  {more.length > 0 && (
    <section class="post-further" aria-labelledby="further-title">
      <h2 id="further-title" class="post-further__title">Read further</h2>
      <ul class="post-further__list">
        {more.slice(0, 4).map((p, i) => (
          <li>
            <a href={`blog/${p.slug}/`}>
              <span class="post-further__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="post-further__main">
                <span class="post-further__name">{p.title}</span>
                <span class="post-further__date">{formatDate(p.date)}{p.tags.length ? '  ·  ' + p.tags[0] : ''}</span>
              </span>
              <span class="post-further__go" aria-hidden="true"><Fragment set:html={arrow} /></span>
            </a>
          </li>
        ))}
      </ul>
      <a class="btn-ghost post-further__back" href="blog/">View all posts</a>
    </section>
  )}
</Layout>
