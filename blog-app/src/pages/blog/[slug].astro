---
import Layout from '../../layouts/Layout.astro';
import PostBody from '../../components/PostBody.tsx';
import { reader, getPosts, formatDate } from '../../lib/posts';
import { AUTHOR, SITE } from '../../lib/site';
import { withHeadingIds, readingMinutes } from '../../lib/doc';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((p) => ({ params: { slug: p.slug } }));
}
const { slug } = Astro.params;
const entry = await reader.collections.posts.read(slug!);
if (!entry) return Astro.redirect('/blog/');
const raw = await entry.body();
const { doc: body, toc } = withHeadingIds(raw as any);
const minutes = readingMinutes(body as any);
const posts = await getPosts();
const more = posts.filter((p) => p.slug !== slug).slice(0, 6);
const path = `/blog/${slug}/`;
const published = entry.date ?? '';
const cover = entry.cover ? '/blog-img/' + entry.cover : null;
---
<Layout
  title={`${entry.title} — Disha Shah`}
  description={entry.summary}
  path={path}
  image={cover ?? undefined}
  type="article"
  published={published}
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: entry.title, description: entry.summary, datePublished: published, author: { '@type': 'Person', name: AUTHOR.name, jobTitle: AUTHOR.role, url: AUTHOR.url }, timeRequired: `PT${minutes}M`, mainEntityOfPage: 'https://disha-shah.io' + path, image: cover ? 'https://disha-shah.io' + cover : undefined },
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://disha-shah.io/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://disha-shah.io/blog/' },
      { '@type': 'ListItem', position: 3, name: entry.title, item: 'https://disha-shah.io' + path },
    ] },
  ]}
>
  <article>
    <header class="wd-head">
      <p class="wd-eyebrow post-meta" data-intro><span>Published: <b>{formatDate(published)}</b></span><i aria-hidden="true"></i><span>Reading time: <b>{minutes} min read</b></span></p>
      <h1 class="wd-title h-primary" data-intro>{entry.title}</h1>
      <p class="wd-sub" data-intro>{entry.summary}</p>
      {entry.tags.length > 0 && (
        <div class="wd-cap" data-intro><span class="wd-cap__label">Topics</span><div class="wd-cap__chips">{entry.tags.map((t) => <span class="chip">{t}</span>)}</div></div>
      )}
      <div class="post-author" data-intro>
        <img src={AUTHOR.photo} alt="" width="44" height="44" />
        <p><b>{AUTHOR.name}</b><span>{AUTHOR.role}</span></p>
      </div>
    </header>
    <div class="post-tools wd-text" data-reveal>
      <div class="post-ai" role="group" aria-label="Summarize with AI">
        <span class="post-label">Summarize with AI</span>
        <div>
          {[['ChatGPT', 'https://chatgpt.com/?q='], ['Claude', 'https://claude.ai/new?q='], ['Perplexity', 'https://www.perplexity.ai/search?q='], ['Google AI', 'https://www.google.com/search?udm=50&q=']].map(([n, u]) => (
            <a href={u + encodeURIComponent(`Summarize this article by ${AUTHOR.name} and list the key takeaways: ${SITE}${path}`)} target="_blank" rel="noopener noreferrer">{n}</a>
          ))}
        </div>
      </div>
      <div class="post-share" role="group" aria-label="Share this article">
        <span class="post-label">Share</span>
        <div>
          <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(SITE + path)}&text=${encodeURIComponent(entry.title)}`} target="_blank" rel="noopener noreferrer">X</a>
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(SITE + path)}`} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <button type="button" data-copy-link={SITE + path}>Copy link</button>
        </div>
      </div>
      {toc.length > 1 && (
        <nav class="post-toc" aria-label="In this article">
          <span class="post-label">In this article</span>
          <ol>{toc.map((t) => <li class={t.level === 3 ? 'is-sub' : ''}><a href={`#${t.id}`}>{t.text}</a></li>)}</ol>
        </nav>
      )}
    </div>
    {cover && (
      <div class="wd-media" data-reveal><img src={cover} alt={entry.coverAlt || entry.title} width="1356" height="763" fetchpriority="high" /></div>
    )}
    <PostBody document={body as any} />
  </article>
  <script is:inline>
    document.querySelectorAll('[data-copy-link]').forEach(function (b) {
      b.addEventListener('click', function () {
        var t = b.getAttribute('data-copy-link'), d = function () { var o = b.textContent; b.textContent = 'Copied'; setTimeout(function () { b.textContent = o; }, 1600); };
        if (navigator.clipboard) navigator.clipboard.writeText(t).then(d, d); else d();
      });
    });
  </script>
  {more.length > 0 && (
    <section class="work wd-more" aria-labelledby="more-title">
      <div class="work__head" data-reveal>
        <p class="eyebrow">Blog</p>
        <h2 id="more-title" class="work__title h-primary">More posts</h2>
      </div>
      <div class="shelf" data-shelf>
        {more.map((p, i) => (
          <a class="case" href={`blog/${p.slug}/`} style={`--i:${i}`}>
            <div class="case__frame"><div class="case__thumb">{p.cover ? <img src={p.cover} alt={p.coverAlt} loading="lazy" /> : <span class="blog-nocover" aria-hidden="true"></span>}</div></div>
            <div class="case__text">
              <h3 class="case__title">{p.title}</h3>
              <p class="case__tags">{formatDate(p.date)}{p.tags.length ? '  ·  ' + p.tags[0] : ''}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</Layout>
